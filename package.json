{
  "name": "brieflock",
  "version": "0.1.0",
  "private": true,
  "description": "BriefLock — secure document exchange and case-file management platform for law firms",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --disable-source-maps",
    "dev:debug": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cloudflare": "opennextjs-cloudflare build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:fixtures": "node --env-file=.env.local scripts/security-workspace.mjs",
    "security:verify": "node --env-file=.env.local scripts/security-workspace.mjs --verify",
    "db:push": "npx --yes supabase@2.6.8 db push",
    "db:migrate": "npx --yes supabase@2.6.8 migration up",
    "db:types": "npx --yes supabase@2.6.8 gen types typescript --local > lib/types/database.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "@opennextjs/aws@4.2.0": { "cookie": "0.7.2" }
  }
}
