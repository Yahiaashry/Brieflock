{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brieflock",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/viewer/*"]
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "brieflock" }],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "BRIEFLOCK_RUNTIME": "cloudflare",
    "BRIEFLOCK_DEMO_SIGNUP": "true",
    "NEXT_PUBLIC_MAX_UPLOAD_MB": "50"
  }
}
