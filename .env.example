# BriefLock — Environment Variable Inventory
# Canonical reference: CONTRACT.md (§ Environment inventory). Never commit real values.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000                # production placeholder: https://app.example.com (domain TBD, D2)
# NEXT_PUBLIC_DEMO_MODE=true                             # opt in to prefilled demo credentials on production builds (local dev is always demo)

# --- Supabase (same region as the app, D2) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key              # RLS applies to every query using this key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key          # SERVER ONLY: scanner transitions, transfer state changes, audit ingest, cron sweeps
SUPABASE_JWT_SECRET=your-jwt-secret                      # verify Bearer tokens (D10)

# --- Privacy (D9) ---
IP_HASH_SALT=generate-a-long-random-salt                 # salts ip_hash (SHA-256); rotation breaks historical hashes — documented tradeoff

# --- Jobs (D6) ---
CRON_SECRET=generate-a-long-random-secret                # protects /api/v1/jobs/*

# --- Email (transactional only) ---
RESEND_API_KEY=re_your_api_key                           # or Supabase built-in SMTP

# --- Observability ---
# SENTRY_DSN=
# LOGTAIL_TOKEN=

# --- Content delivery ---
SIGNED_URL_TTL_SECONDS=60                                # default 60 · hard cap 60 (ADR-1)

# --- Future (D7) — uncomment only when swapping in-memory rate limiting for Upstash ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
